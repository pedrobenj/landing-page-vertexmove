# Banco (Neon ou Supabase — a confirmar)
DATABASE_URL="postgresql://usuario:senha@localhost:5432/vertex?schema=public"

# NextAuth (admin) — gerar com: npx auth secret
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Gateway de pagamento (a confirmar com o cliente)
PAYMENT_ACCESS_TOKEN=
PAYMENT_WEBHOOK_SECRET=

# E-mail transacional
RESEND_API_KEY=
EMAIL_FROM="Vertex Grupo de Corrida <inscricoes@seudominio.com.br>"

# Storage de imagens
BLOB_READ_WRITE_TOKEN=

# Públicas
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_INSTAGRAM_URL=

# Dados fictícios no front enquanto não há banco (somente desenvolvimento)
USE_MOCK_DATA=false
