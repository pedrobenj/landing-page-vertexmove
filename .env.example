# Backend VertexMove (sem /api/v1). Só no servidor: nunca use o prefixo NEXT_PUBLIC_.
API_URL=http://localhost:3000
API_TIMEOUT_MS=10000

# Responde as chamadas à API com dados fictícios, sem backend (somente desenvolvimento;
# recusado com NODE_ENV=production). A loja só funciona com o mock até o backend expor a API.
USE_MOCK_API=false

# Hosts das imagens remotas (capas, fotos de kit, logos), separados por vírgula, sem protocolo.
# Aceita curinga de subdomínio (ex.: **.cloudfront.net). Lido no build (next.config.ts).
IMAGE_REMOTE_HOSTS=

# Públicas
NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_INSTAGRAM_URL=
